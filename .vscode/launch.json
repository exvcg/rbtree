{
    "version": "0.2.0",
    "configurations": [
        
      {
        "name": "GDB Debug - Test RBT",
        "type": "cppdbg",
        "request": "launch",
        "program": "${workspaceFolder}/test/test-rbtree.exe",  // 빌드 후 생성된 테스트 실행 파일
        "args": [],
        "stopAtEntry": false,
        "cwd": "${workspaceFolder}/test",
        "environment": [],
        "externalConsole": true,
        "MIMode": "gdb",
        "miDebuggerPath": "gdb", // 전체 경로 지정 가능
        "setupCommands": [
          {
            "description": "Enable pretty-printing",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    ]
  }
  