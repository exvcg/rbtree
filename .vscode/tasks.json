{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "mingw32-make",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"  // 현재 작업 디렉토리 기준
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "debug",
            "type": "shell",
            "command": "gdb",
            "args": [
                "${workspaceFolder}/driver"  // 빌드 후 실행할 프로그램
            ],
            "options": {
                "cwd": "${workspaceFolder}"  // 현재 작업 디렉토리 기준
            },
            "dependsOn": ["build"],  // build task가 먼저 실행되도록 설정
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": []
        }
    ]
}